{
  "name": "optocom-visao-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:production-guards": "node scripts/test-production-guards.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "test:backup": "pwsh -NoProfile -File scripts/backup/Test-Backup.ps1",
    "test:retention": "pwsh -NoProfile -File scripts/backup/Test-Retention.ps1",
    "admins:provision": "node scripts/provision-admins.mjs",
    "test:browser:portfolio": "node scripts/test-browser-portfolio.mjs"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "supabase": "2.122.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
